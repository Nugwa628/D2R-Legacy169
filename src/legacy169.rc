#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

1 VERSIONINFO  // 1 = VS_VERSION_INFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS 0x40004  // VOS_NT_WINDOWS32
 FILETYPE 0x2  // VFT_DLL
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Legacy 16:9 D2RLoader plugin (legacy169)"
			VALUE "FileVersion", "0.1.0"
			VALUE "ProductName", "D2R Legacy 16:9"
			VALUE "ProductVersion", "0.1.0"
			VALUE "OriginalFilename", "legacy169.dll"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
